{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --prefix project",
  "buildCommand": "npm run build --prefix project",
  "devCommand": "npm run dev --prefix project",
  "outputDirectory": "project/dist",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- project/",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
